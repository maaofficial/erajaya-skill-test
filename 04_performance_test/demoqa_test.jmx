          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Pick random ISBN from list" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">int n = (vars.get(&quot;isbn_matchNr&quot;) ?: &quot;0&quot;) as int
vars.put(&quot;selectedIsbn&quot;, n &gt; 0 ? vars.get(&quot;isbn_&quot; + (1 + new Random().nextInt(n))) : vars.get(&quot;csvIsbn&quot;))</stringProp>
          </JSR223Sampler>
